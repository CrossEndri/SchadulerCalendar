rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      // Allow anyone to read events (guest access)
      allow read: if true;
      
      // Allow update and delete only if the user is authenticated and owns the document
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Allow create if the user is authenticated and the new document's userId matches their UID
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
  }
}
